{
  "name": "PLE - Daily Metrics & Executive Overview",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 23 * * *"
            }
          ]
        }
      },
      "name": "Daily Snapshot (23:00 BRT)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.PLE_API_BASE_URL }}/admin/overview",
        "method": "GET",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PLE_API_KEY }}"
            },
            {
              "name": "X-Timestamp",
              "value": "={{ Date.now() }}"
            },
            {
              "name": "X-Request-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        }
      },
      "name": "Aggregate Daily Executive Metrics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Daily Snapshot (23:00 BRT)": {
      "main": [
        [
          {
            "node": "Aggregate Daily Executive Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

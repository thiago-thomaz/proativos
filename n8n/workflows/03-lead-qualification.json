{
  "name": "PLE - Lead Qualification & Scoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/15 8-19 * * 1-5"
            }
          ]
        }
      },
      "name": "Periodic Qualification Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.PLE_API_BASE_URL }}/icp/score",
        "method": "POST",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PLE_API_KEY }}"
            },
            {
              "name": "X-Timestamp",
              "value": "={{ Date.now() }}"
            },
            {
              "name": "X-Request-Id",
              "value": "={{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "batchMode",
              "value": true
            },
            {
              "name": "limit",
              "value": 50
            }
          ]
        }
      },
      "name": "Evaluate & Score Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Periodic Qualification Schedule": {
      "main": [
        [
          {
            "node": "Evaluate & Score Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

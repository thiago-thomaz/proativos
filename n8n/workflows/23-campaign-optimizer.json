{
  "name": "23-Campaign-Optimizer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "name": "Daily Optimization",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3000/api/v1/experiments",
        "options": {}
      },
      "name": "Evaluate Experiments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    }
  ],
  "connections": {
    "Daily Optimization": {
      "main": [
        [
          {
            "node": "Evaluate Experiments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}

{
  "name": "PLE - Reactivation Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "node-cron-reactivate",
      "name": "Schedule Trigger (Diário)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.NEXT_APP_URL }}/api/v1/opportunities/recommendations",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.PLE_API_KEY }}"
            }
          ]
        }
      },
      "id": "node-http-reactivate",
      "name": "Checar Oportunidades Elegíveis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (Diário)": {
      "main": [
        [
          {
            "node": "Checar Oportunidades Elegíveis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}

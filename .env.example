# -------------------------------------------------------------
# PROACTIVE LEAD ENGINE — PRODUCTION ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Database
DATABASE_URL="file:./dev.db"

# Control Plane & Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="generate_a_secure_random_jwt_secret_here"

# N8N Webhook Security & Orchestration
PLE_API_URL="http://localhost:3000/api/v1"
PLE_N8N_API_KEY="ple_live_production_key_placeholder"
PLE_WEBHOOK_SECRET="ple_hmac_sha256_secret_placeholder"

# Email Providers (Resend / AWS SES)
EMAIL_PROVIDER="RESEND"
RESEND_API_KEY=""
EMAIL_FROM_DEFAULT="comercial@suaempresa.com.br"

# WhatsApp Providers (Meta WhatsApp Cloud API / Z-API / Evolution)
WHATSAPP_PROVIDER="META_CLOUD"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_WABA_ID=""

# Enrichment & Data Providers
CNPJ_PROVIDER="RECEITA_FEDERAL"
ASSERTIVA_API_KEY=""
BIGDATACORP_API_KEY=""

# Outreach & Safety
OUTREACH_KILL_SWITCH=false
DEFAULT_TIMEZONE="America/Sao_Paulo"

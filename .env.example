# -------------------------------------------------------------
# PROACTIVE LEAD ENGINE — PRODUCTION ENVIRONMENT CONFIGURATION
# Padronizado para deploy contínuo via Coolify (Zero n8n)
# -------------------------------------------------------------

# Database
# Para SQLite: "file:./dev.db" ou "file:/app/prisma/data/production.db"
# Para Postgres: "postgresql://user:password@postgres:5432/leads_db?schema=public"
DATABASE_URL="file:./dev.db"

# Servidor & Porta
PORT=3000
NODE_ENV="production"
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Segurança & Autenticação
JWT_SECRET="generate_a_secure_random_jwt_secret_64_characters"
NEXTAUTH_SECRET="generate_a_secure_random_nextauth_secret_32_characters"
NEXTAUTH_URL="http://localhost:3000"

# Motor de Automação Nativo Interno (Zero n8n)
ENABLE_INTERNAL_SCHEDULER="true"
INTERNAL_API_KEY="ple_live_sec_your_internal_automation_key_placeholder"
INTERNAL_WEBHOOK_SECRET="whsec_your_production_webhook_secret_placeholder"

# Provedores de Email (Resend / AWS SES / MOCK)
EMAIL_PROVIDER="RESEND"
RESEND_API_KEY=""
EMAIL_FROM_DEFAULT="comercial@suaempresa.com.br"

# Provedores de WhatsApp (Meta WhatsApp Cloud API / Z-API / Evolution / MOCK)
WHATSAPP_PROVIDER="META_CLOUD"
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_NUMBER_ID=""
META_WHATSAPP_WABA_ID=""

# Enriquecimento de Dados & Provedores Cadastrais
CNPJ_PROVIDER="RECEITA_FEDERAL"
ASSERTIVA_API_KEY=""
BIGDATACORP_API_KEY=""

# Inteligência Artificial & NLP
AI_PROVIDER="MOCK"
AI_API_KEY=""

# Faturamento & Gateway de Pagamentos
BILLING_PROVIDER="MOCK"
BILLING_API_KEY=""

# Salvaguardas & Segurança Operacional (SRE)
OUTREACH_KILL_SWITCH="false"
DEFAULT_TIMEZONE="America/Sao_Paulo"
